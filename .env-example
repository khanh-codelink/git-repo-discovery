AZURE_OPENAI_API_KEY="azure_openai_api_key"
GITHUB_TOKEN="personal_git_access_token"
AZURE_OPENAI_ENDPOINT="azure_endpoint"

## LLM Model

AZURE_OPENAI_MODEL_NAME=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini

## Langfuse tracing (optional: the app runs without traces when the keys are unset)

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000
# From inside a Docker container use: http://host.docker.internal:3000
LANGFUSE_TRACING_ENABLED=true

SUPABASE_URL="supabase_url"
SUPABASE_KEY="supabase_key"

FE_APP_DOMAIN="your_fe_domain_to_prevent_cors"

# Only needed to run Alembic migrations (Project → Connect → Session pooler)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
